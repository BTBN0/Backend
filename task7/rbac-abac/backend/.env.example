# ─── Database (MySQL) ────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/rbac_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
