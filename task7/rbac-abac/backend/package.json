{
  "name": "rbac-abac-backend",
  "version": "1.0.0",
  "description": "Prisma + Express RBAC/ABAC backend",
  "main": "src/app.js",
  "scripts": {
    "dev":        "nodemon src/app.js",
    "start":      "node src/app.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:push":    "npx prisma db push",
    "db:seed":    "node prisma/seed.js",
    "db:studio":  "npx prisma studio",
    "db:reset":   "npx prisma migrate reset --force && node prisma/seed.js",
    "setup":      "npm install && npx prisma generate && npx prisma db push && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs":       "^2.4.3",
    "cors":           "^2.8.5",
    "dotenv":         "^16.4.5",
    "express":        "^4.21.1",
    "jsonwebtoken":   "^9.0.2"
  },
  "devDependencies": {
    "nodemon":  "^3.1.7",
    "prisma":   "^5.22.0"
  }
}
